<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS URL Rewrite for the Angular SPA.

  Deep links (/admin/dashboard, /login, /parent, etc.) must resolve to
  index.html so the Angular Router can pick them up client-side.  Without
  this rule IIS returns 404 for any URL that isn't a real file/folder,
  because the "routes" only exist in JavaScript.

  Requires the "URL Rewrite 2.x" IIS module (install once per server:
  https://www.iis.net/downloads/microsoft/url-rewrite).

  Place this file next to index.html in the site's web root and include
  it in the Angular build output so every deploy carries it along
  (angular.json → assets → { glob: "web.config", input: "src", output: "/" }).
-->
<configuration>
  <system.webServer>

    <!-- Make sure IIS knows the SPA's static file types. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- 1) Never rewrite calls to the API — they need to fall through
             to whatever proxy / reverse-proxy sends them to CleanArc.Web.Api. -->
        <rule name="Skip API" stopProcessing="true">
          <match url="^api/" />
          <action type="None" />
        </rule>

        <!-- 2) Angular deep-link fallback.
             If the request isn't for a real file or folder, serve index.html.
             The client-side Router reads location.pathname and navigates. -->
        <rule name="Angular SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- SPA bundles are hashed per build, so we can safely cache them hard.
         index.html itself must NOT be cached long or users won't pick up
         new hashed bundle names after a deploy. -->
    <caching>
      <profiles>
        <add extension=".html" policy="DisableCache" kernelCachePolicy="DontCache" />
      </profiles>
    </caching>

  </system.webServer>
</configuration>
