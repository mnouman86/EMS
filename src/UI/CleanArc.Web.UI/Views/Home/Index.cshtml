@model List<string>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<h1>File Upload</h1>

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="file">Upload file:</label>
        <input type="file" name="file" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

<h1>Delete Image</h1>

<!-- Delete Form -->
<form asp-action="Delete" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <input type="text" name="category" placeholder="Category" class="form-control" />
        <input type="text" name="fileName" placeholder="File Name" class="form-control" />
    </div>
    <button type="submit" class="btn btn-danger">Delete</button>
</form>

<!-- Update Form -->
<h1>Update Images</h1>
<form method="post" asp-action="Update" enctype="multipart/form-data">
    <div class="form-group">
        <input type="text" name="category" placeholder="Category" class="form-control" />
        <input type="text" name="fileName" placeholder="File Name" class="form-control" />
        <input type="file" name="newFile" class="form-control" />
    </div>
    <button type="submit" class="btn btn-warning">Update</button>
</form>

<h1>Manage Image</h1>
<!--image get-->
<form asp-action="GetImage" method="get" class="mt-3">
    <div class="form-group">
        <input type="text" name="category" placeholder="Category" class="form-control" />
    </div>
    <div class="form-group">
        <input type="text" name="fileName" placeholder="File Name" class="form-control" />
    </div>
    <button type="submit" class="btn btn-info">Get Image</button>
</form>

@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <div class="container mt-3">
        <div class="alert alert-success">
            @ViewBag.Message
        </div>
    </div>
}

<hr />

<h1>Uploaded Images</h1>

@if (Model != null && Model.Count > 0)
{
    <div class="row">
        @foreach (var imagePath in Model)
        {
            <div class="col-md-3 mb-3">
                <div class="card">
                    <img src="@Url.Content(imagePath)" class="card-img-top" alt="Uploaded Image" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">Image Title</h5>
                        <!-- Add additional details or controls if needed -->
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No images uploaded yet.</p>
}
